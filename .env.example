# Copy to backend/.env for local development. Merge with existing values; do not overwrite an existing file.
DATABASE_URL=sqlite:///./synex.db
# Generate two independent random values of at least 32 characters. Never commit real secrets.
SECRET_KEY=
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Enable both LinkedIn products: Sign In with LinkedIn using OpenID Connect and Share on LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register this exact URL in the LinkedIn developer app. Used by both sign-in and connection.
LINKEDIN_REDIRECT_URI=http://localhost:8010/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202610

# Server-side browser sessions for LinkedIn accounts (all optional; these are the defaults).
LINKEDIN_SESSION_MAX_BROWSERS=3
LINKEDIN_SESSION_ATTEMPT_TIMEOUT_SECONDS=600
LINKEDIN_SESSION_POLL_INTERVAL_SECONDS=1.0
# Set to false to watch the browser while developing selectors.
LINKEDIN_SESSION_HEADLESS=true

# Proxy test: one request to this neutral endpoint (never LinkedIn) through the proxy under test.
LINKEDIN_PROXY_TEST_URL=https://ipinfo.io/json
LINKEDIN_PROXY_TEST_TIMEOUT_SECONDS=10
LINKEDIN_PROXY_TEST_ALLOW_PRIVATE=false

# Outreach worker (python -m app.outreach_worker). All optional; these are the defaults.
OUTREACH_KILL_SWITCH=false
OUTREACH_TICK_INTERVAL_SECONDS=30
OUTREACH_ACTION_GAP_MIN_SECONDS=45
OUTREACH_ACTION_GAP_MAX_SECONDS=180
OUTREACH_BATCH_MAX_ACTIONS=5
OUTREACH_WEEKLY_CONNECTION_LIMIT=100
OUTREACH_MAX_CONSECUTIVE_FAILURES=5
OUTREACH_TASK_MAX_ATTEMPTS=3
OUTREACH_TASK_RETRY_BACKOFF_SECONDS=120
OUTREACH_STALE_TASK_SECONDS=600
OUTREACH_ACCEPTANCE_CHECK_INTERVAL_HOURS=12
OUTREACH_INBOX_SYNC_INTERVAL_MINUTES=15


# Required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
