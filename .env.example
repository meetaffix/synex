# One .env for the whole project: the backend, both workers and the Vite frontend read it from this folder.
# Copy this file to .env and fill it in. Never commit .env. Check it (names and formats only, never values) with:
#   cd backend && python -m app.check_env
# Lines starting with "# NAME=" are optional and show the default.

# ---- Required ---------------------------------------------------------------------------------------------------
# Two independent random values of at least 32 characters each.
SECRET_KEY=
ENCRYPTION_KEY=
# sqlite:///./synex.db for local use, or the CockroachDB / Postgres URL (cockroachdb://user:password@host:26257/db?sslmode=verify-full&sslrootcert=/path/root.crt).
DATABASE_URL=sqlite:///./synex.db
# Origins allowed to call the API, comma separated, no paths. Add the deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex that must match a whole origin (for example one Vercel project's previews). Never a *.vercel.app wildcard.
# CORS_ORIGIN_REGEX=

# ---- Authentication: local (built-in sign-in) or clerk (Clerk is the only way in) -----------------------------------
AUTH_PROVIDER=local
# Needed when AUTH_PROVIDER=clerk. The secret key stays on the server; the publishable key is public.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: signing secret of the Clerk webhook (whsec_...), and an issuer override.
# CLERK_WEBHOOK_SECRET=
# CLERK_ISSUER=

# ---- AI: Deepgram is the only AI provider ---------------------------------------------------------------------------
# Leave empty to turn the assistant and AI drafting off (templates with variables and spintax are used instead).
DEEPGRAM_API_KEY=
# Optional overrides (defaults shown). See docs/ASSISTANT.md.
# ASSISTANT_LLM_PROVIDER=anthropic
# ASSISTANT_LLM_MODEL=claude-haiku-4-5
# ASSISTANT_VOICE=aura-2-hera-en
# ASSISTANT_STT_MODEL=nova-3
# ASSISTANT_DEFAULT_MONTHLY_MINUTES=60
# ASSISTANT_DEFAULT_IDLE_SECONDS=120

# ---- Frontend (Vite exposes only names that start with VITE_ to the browser) ----------------------------------------
VITE_API_URL=http://localhost:8010

# ---- Deployment ---------------------------------------------------------------------------------------------------
# Where the frontend is served, used in links. Set to https://... when deployed.
FRONTEND_URL=http://localhost:5173
# true when the site is served over HTTPS (only matters for the built-in sign-in cookie).
COOKIE_SECURE=false

# ---- Content publishing (secondary feature) -------------------------------------------------------------------------
# LinkedIn developer app: Sign In with LinkedIn (OpenID Connect) and Share on LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register this exact URL in the LinkedIn developer app.
LINKEDIN_REDIRECT_URI=http://localhost:8010/linkedin/callback
# LINKEDIN_SCOPES=openid profile email w_member_social
# LINKEDIN_API_VERSION=202610

# ---- Email (UNUSED when AUTH_PROVIDER=clerk: Clerk sends sign-in and reset emails) ---------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@synex.local

# ---- Sender browser sessions (all optional; these are the defaults) -------------------------------------------------------
# LINKEDIN_SESSION_MAX_BROWSERS=3
# LINKEDIN_SESSION_ATTEMPT_TIMEOUT_SECONDS=600
# LINKEDIN_SESSION_POLL_INTERVAL_SECONDS=1.0
# LINKEDIN_SESSION_HEADLESS=true
# Where a failed login's redacted screenshot is saved (this machine only; default backend/captures)
# LINKEDIN_CAPTURE_DIR=
# Proxy test calls this neutral endpoint (never LinkedIn) through the proxy under test.
# LINKEDIN_PROXY_TEST_URL=https://ipinfo.io/json
# LINKEDIN_PROXY_TEST_TIMEOUT_SECONDS=10
# LINKEDIN_PROXY_TEST_ALLOW_PRIVATE=false

# ---- Outreach worker (python -m app.outreach_worker; all optional, defaults shown) ------------------------------------------
# OUTREACH_KILL_SWITCH=false
# OUTREACH_TICK_INTERVAL_SECONDS=30
# OUTREACH_ACTION_GAP_MIN_SECONDS=45
# OUTREACH_ACTION_GAP_MAX_SECONDS=180
# OUTREACH_BATCH_MAX_ACTIONS=5
# OUTREACH_WEEKLY_CONNECTION_LIMIT=100
# OUTREACH_MAX_CONSECUTIVE_FAILURES=5
# OUTREACH_TASK_MAX_ATTEMPTS=3
# OUTREACH_TASK_RETRY_BACKOFF_SECONDS=120
# OUTREACH_LEASE_SECONDS=300
# OUTREACH_STALE_TASK_SECONDS=600
# OUTREACH_ACCEPTANCE_CHECK_INTERVAL_HOURS=12
# OUTREACH_INBOX_SYNC_INTERVAL_MINUTES=15
