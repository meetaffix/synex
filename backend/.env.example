# Copy to backend/.env for local development. Merge with existing values; do not overwrite an existing file.
DATABASE_URL=sqlite:///./synex.db
# Generate two independent random values of at least 32 characters. Never commit real secrets.
SECRET_KEY=
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Enable both LinkedIn products: Sign In with LinkedIn using OpenID Connect and Share on LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register this exact URL in the LinkedIn developer app. Used by both sign-in and connection.
LINKEDIN_REDIRECT_URI=http://localhost:8010/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202610

# Optional writing assistance. Missing configuration produces an explicit unavailable response.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
